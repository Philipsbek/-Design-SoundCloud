---
import { art } from '../data/content.js';
export interface Props { name: string; followers: string; seed: string; }
const { name, followers, seed } = Astro.props;
const cover = art(seed, 320);
---
<article class="ac" data-search={name.toLowerCase()}>
  <div class="ac__art">
    <img class="ac__img" src={cover} alt={name} loading="lazy" />
  </div>
  <h3 class="ac__name">{name}</h3>
  <p class="ac__meta">{followers} followers</p>
  <button class="ac__follow">Follow</button>
</article>

<style>
  .ac { text-align: center; min-width: 0; }
  .ac.is-filtered { display: none; }
  .ac__art {
    aspect-ratio: 1/1; border-radius: 50%; overflow: hidden; background: var(--color-graphite);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .ac__img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .ac:hover .ac__img { transform: scale(1.05); }
  .ac__name {
    margin-top: var(--s12); font-size: var(--text-body-sm); font-weight: 600; color: var(--color-white);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ac__meta { font-size: var(--text-caption); color: var(--color-fog); margin-top: 2px; }
  .ac__follow {
    margin-top: var(--s12); font-size: var(--text-caption); font-weight: 600; color: var(--color-white);
    height: 28px; padding: 0 var(--s16); border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--hairline-strong); transition: box-shadow .18s ease, background .18s ease, color .18s ease;
  }
  .ac__follow:hover { box-shadow: inset 0 0 0 1px var(--color-orange); color: var(--color-orange); }
  .ac__follow.is-following { background: var(--color-orange); color: #fff; box-shadow: none; }
</style>

<script>
  document.querySelectorAll('.ac__follow').forEach((b) =>
    b.addEventListener('click', () => {
      const on = b.classList.toggle('is-following');
      b.textContent = on ? 'Following' : 'Follow';
    })
  );
</script>
