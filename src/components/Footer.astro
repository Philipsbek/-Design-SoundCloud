---
const legal = ['Legal', 'Privacy', 'Cookie Policy', 'Consent Settings', 'Imprint', 'Artist Resources', 'Blog', 'Popular searches'];
const explore = ['Charts', 'Discover', 'Trending', 'Community', 'Company', 'Jobs', 'Developers', 'Support'];
---
<footer class="ft">
  <div class="container ft__inner">
    <div class="ft__row ft__row--links">
      <nav class="ft__links" aria-label="Explore">
        {explore.map((l) => <a href="#" class="ft__link">{l}</a>)}
      </nav>
      <div class="ft__apps">
        <a href="#" class="ft__badge">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16.5 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2-.05 1.6-.75 3-.75s1.8.75 3 .73c1.2-.02 2-1.1 2.8-2.2.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-.95-2.5-3.8z"/></svg>
          App Store
        </a>
        <a href="#" class="ft__badge">
          <svg viewBox="0 0 24 24" width="15" height="15"><path d="M3.6 2.3c-.2.2-.3.5-.3.9v17.6c0 .4.1.7.3.9L13.5 12z" fill="currentColor"/></svg>
          Google Play
        </a>
      </div>
    </div>

    <div class="ft__row ft__row--legal">
      <div class="ft__brand">
        <span class="ft__logo">SOUNDCLOUD</span>
        <span class="ft__note">Design demo — not affiliated with SoundCloud.</span>
      </div>
      <nav class="ft__legal" aria-label="Legal">
        {legal.map((l) => <a href="#" class="ft__legalLink">{l}</a>)}
        <span class="ft__legalLink ft__lang">English (US) ▾</span>
      </nav>
    </div>
  </div>
</footer>

<style>
  .ft { padding: var(--s48) 0 var(--s32); box-shadow: inset 0 1px 0 var(--hairline); margin-top: var(--s24); }
  .ft__row--links { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s24); padding-bottom: var(--s32); box-shadow: inset 0 -1px 0 var(--hairline); flex-wrap: wrap; }
  .ft__links { display: flex; flex-wrap: wrap; gap: var(--s8) var(--s24); max-width: 700px; }
  .ft__link { color: var(--color-silver); font-size: var(--text-body-sm); font-weight: 600; transition: color .15s ease; }
  .ft__link:hover { color: var(--color-orange); }
  .ft__apps { display: flex; gap: var(--s8); }
  .ft__badge { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-caption); font-weight: 600; color: #fff; background: #000; padding: 8px 12px; border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--hairline-strong); transition: transform .15s ease; }
  .ft__badge:hover { transform: translateY(-2px); }

  .ft__row--legal { display: flex; align-items: center; justify-content: space-between; gap: var(--s16); padding-top: var(--s24); flex-wrap: wrap; }
  .ft__brand { display: flex; flex-direction: column; gap: 2px; }
  .ft__logo { font-size: var(--text-body-sm); font-weight: 700; color: var(--color-white); }
  .ft__note { font-size: var(--text-caption); color: var(--color-mid-gray); }
  .ft__legal { display: flex; flex-wrap: wrap; gap: var(--s8) var(--s16); }
  .ft__legalLink { font-size: var(--text-caption); color: var(--color-fog); transition: color .15s ease; }
  .ft__legalLink:hover { color: var(--color-white); }
  .ft__lang { cursor: pointer; }

  @media (max-width: 640px) { .ft__row--links { flex-direction: column; } }
</style>
