---
import { nowPlaying, art } from '../data/content.js';
// deterministic waveform heights (0.15–1.0)
const bars = Array.from({ length: 90 }, (_, i) => {
  const v = Math.abs(Math.sin(i * 0.7) * 0.6 + Math.sin(i * 0.23) * 0.4);
  return Math.max(0.16, Math.min(1, v));
});
const startCover = art(nowPlaying.seed, 100);
---
<div class="pb" id="playbar"
  data-title={nowPlaying.title} data-artist={nowPlaying.artist} data-cover={startCover}>
  <div class="pb__inner">
    <!-- transport -->
    <div class="pb__transport">
      <button class="pb__ctrl" id="pb-prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 5v14M20 5v14l-11-7z" fill="currentColor"/></svg>
      </button>
      <button class="pb__play" id="pb-play" aria-label="Play">
        <svg class="pb__playIcon" viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        <svg class="pb__pauseIcon" viewBox="0 0 24 24" width="20" height="20"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
      </button>
      <button class="pb__ctrl" id="pb-next" aria-label="Next">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M18 5v14M4 5v14l11-7z" fill="currentColor"/></svg>
      </button>
      <button class="pb__ctrl pb__ctrl--sm" id="pb-shuffle" aria-label="Shuffle">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 7h4l3 4M4 17h4l9-12h3m0 0l-2-2m2 2l-2 2M14 13l3 4h3m0 0l-2-2m2 2l-2 2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="pb__ctrl pb__ctrl--sm" id="pb-repeat" aria-label="Repeat">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M17 3l3 3-3 3M20 6H8a4 4 0 0 0-4 4M7 21l-3-3 3-3M4 18h12a4 4 0 0 0 4-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <!-- time + waveform -->
    <div class="pb__timeline">
      <span class="pb__time" id="pb-cur">0:00</span>
      <div class="pb__wave" id="pb-wave" role="slider" aria-label="Seek" tabindex="0">
        <div class="pb__waveBars pb__waveBars--bg">
          {bars.map((h) => <i style={`height:${(h * 100).toFixed(0)}%`}></i>)}
        </div>
        <div class="pb__played" id="pb-played">
          <div class="pb__waveBars pb__waveBars--fg" style={`width:${bars.length * 3}px`}>
            {bars.map((h) => <i style={`height:${(h * 100).toFixed(0)}%`}></i>)}
          </div>
        </div>
      </div>
      <span class="pb__time" id="pb-dur">3:24</span>
    </div>

    <!-- now playing -->
    <div class="pb__now">
      <img class="pb__cover" id="pb-cover" src={startCover} alt="" />
      <div class="pb__meta">
        <span class="pb__t" id="pb-title">{nowPlaying.title}</span>
        <span class="pb__a" id="pb-artist">{nowPlaying.artist}</span>
      </div>
      <button class="pb__heart" id="pb-like" aria-label="Like">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 20s-7-4.35-9.5-8.5A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5.5C19 15.65 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      </button>
      <div class="pb__vol">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16 8a4 4 0 0 1 0 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <div class="pb__volBar"><div class="pb__volFill" id="pb-volfill"></div></div>
      </div>
    </div>
  </div>
</div>

<style>
  .pb {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 300;
    height: var(--playbar-h);
    background: var(--color-obsidian);
    box-shadow: inset 0 1px 0 var(--hairline);
  }
  .pb__inner { max-width: var(--page-max); margin: 0 auto; height: 100%; display: flex; align-items: center; gap: var(--s16); padding-inline: var(--s16); }

  .pb__transport { display: flex; align-items: center; gap: var(--s4); flex: none; }
  .pb__ctrl { width: 30px; height: 30px; display: grid; place-items: center; color: var(--color-silver); border-radius: 50%; transition: color .15s ease, background .15s ease; }
  .pb__ctrl:hover { color: var(--color-white); background: rgba(255,255,255,.08); }
  .pb__ctrl--sm { color: var(--color-fog); }
  .pb__ctrl--sm.is-on { color: var(--color-orange); }
  .pb__play {
    width: 34px; height: 34px; border-radius: 50%; background: var(--color-orange); color: #fff;
    display: grid; place-items: center; margin-inline: 2px; transition: background .15s ease, transform .1s ease;
  }
  .pb__play:hover { background: var(--color-orange-hi); }
  .pb__play:active { transform: scale(.94); }
  .pb__pauseIcon { display: none; }
  .pb.is-playing .pb__playIcon { display: none; }
  .pb.is-playing .pb__pauseIcon { display: block; }

  .pb__timeline { display: flex; align-items: center; gap: var(--s12); flex: 1 1 auto; min-width: 0; }
  .pb__time { font-size: 11px; color: var(--color-fog); font-variant-numeric: tabular-nums; flex: none; width: 30px; text-align: center; }
  .pb__wave { position: relative; flex: 1 1 auto; height: 34px; cursor: pointer; overflow: hidden; }
  .pb__waveBars { display: flex; align-items: center; gap: 1px; height: 100%; }
  .pb__waveBars i { flex: 1 0 2px; min-width: 2px; border-radius: 1px; }
  .pb__waveBars--bg i { background: var(--color-mid-gray); opacity: .55; }
  .pb__waveBars--fg i { background: var(--color-orange); }
  .pb__played { position: absolute; inset: 0; width: 30%; overflow: hidden; will-change: width; }
  .pb__waveBars--fg { position: absolute; left: 0; top: 0; }

  .pb__now { display: flex; align-items: center; gap: var(--s8); flex: none; width: 260px; }
  .pb__cover { width: 32px; height: 32px; border-radius: 3px; object-fit: cover; flex: none; background: var(--color-graphite); }
  .pb__meta { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .pb__t { font-size: var(--text-caption); font-weight: 600; color: var(--color-white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pb__a { font-size: 11px; color: var(--color-fog); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pb__heart { color: var(--color-fog); width: 26px; height: 26px; display: grid; place-items: center; flex: none; transition: color .15s ease, transform .15s ease; }
  .pb__heart:hover { color: var(--color-white); }
  .pb__heart.is-liked { color: var(--color-orange); }
  .pb__heart.is-liked svg path { fill: var(--color-orange); }
  .pb__vol { display: flex; align-items: center; gap: 6px; color: var(--color-fog); flex: none; }
  .pb__volBar { width: 60px; height: 4px; border-radius: 2px; background: var(--color-graphite); overflow: hidden; cursor: pointer; }
  .pb__volFill { height: 100%; width: 75%; background: var(--color-silver); }

  @media (max-width: 900px) { .pb__now { width: 200px; } .pb__vol { display: none; } }
  @media (max-width: 640px) {
    .pb__transport .pb__ctrl--sm { display: none; }
    .pb__now { width: auto; }
    .pb__meta { display: none; }
    .pb__time#pb-dur { display: none; }
  }
  @media (max-width: 480px) { .pb__timeline { display: none; } .pb__now { flex: 1; } }
</style>

<script>
  const pb = document.getElementById('playbar');
  const playedEl = document.getElementById('pb-played');
  const wave = document.getElementById('pb-wave');
  const curEl = document.getElementById('pb-cur');
  const durEl = document.getElementById('pb-dur');
  const titleEl = document.getElementById('pb-title');
  const artistEl = document.getElementById('pb-artist');
  const coverEl = document.getElementById('pb-cover');
  const playBtn = document.getElementById('pb-play');

  const queue = [...document.querySelectorAll('[data-play]')];
  const DURATION = 204; // 3:24 in seconds
  let progress = 0;      // 0..1
  let playing = false;
  let timer = null;
  let currentCard = null;

  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  const render = () => {
    playedEl.style.width = (progress * 100) + '%';
    curEl.textContent = fmt(progress * DURATION);
  };

  const markCard = () => {
    document.querySelectorAll('.tc.is-playing, .pc.is-playing').forEach((c) => c.classList.remove('is-playing'));
    if (currentCard && playing) currentCard.classList.add('is-playing');
  };

  const setPlaying = (v) => {
    playing = v;
    pb.classList.toggle('is-playing', v);
    playBtn.setAttribute('aria-label', v ? 'Pause' : 'Play');
    if (timer) { clearInterval(timer); timer = null; }
    if (v) {
      timer = setInterval(() => {
        progress += 1 / DURATION;
        if (progress >= 1) { progress = 0; loadCard(nextCard(), true); return; }
        render();
      }, 1000);
    }
    markCard();
  };

  const loadCard = (card, autoplay) => {
    if (!card) return;
    currentCard = card;
    titleEl.textContent = card.dataset.title;
    artistEl.textContent = card.dataset.artist;
    coverEl.src = card.dataset.cover;
    progress = 0; render();
    if (autoplay) setPlaying(true); else markCard();
  };

  const indexOfCurrent = () => queue.indexOf(currentCard);
  const nextCard = () => queue[(indexOfCurrent() + 1 + queue.length) % queue.length];
  const prevCard = () => queue[(indexOfCurrent() - 1 + queue.length) % queue.length];

  // click a card's play button
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.tc__play, .pc__play');
    if (!btn) return;
    e.preventDefault();
    const card = btn.closest('[data-play]');
    if (card === currentCard) { setPlaying(!playing); }
    else { loadCard(card, true); }
  });

  playBtn.addEventListener('click', () => {
    if (!currentCard) currentCard = queue[0];
    setPlaying(!playing);
  });
  document.getElementById('pb-next').addEventListener('click', () => loadCard(nextCard(), true));
  document.getElementById('pb-prev').addEventListener('click', () => {
    if (progress > 0.04) { progress = 0; render(); } else loadCard(prevCard(), true);
  });

  // seek
  const seek = (e) => {
    const r = wave.getBoundingClientRect();
    progress = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    render();
  };
  wave.addEventListener('click', seek);
  wave.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { progress = Math.min(1, progress + 0.05); render(); }
    if (e.key === 'ArrowLeft') { progress = Math.max(0, progress - 0.05); render(); }
  });

  // volume
  const volBar = document.querySelector('.pb__volBar');
  const volFill = document.getElementById('pb-volfill');
  volBar?.addEventListener('click', (e) => {
    const r = volBar.getBoundingClientRect();
    volFill.style.width = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100)) + '%';
  });

  // toggles
  document.getElementById('pb-like').addEventListener('click', (e) => e.currentTarget.classList.toggle('is-liked'));
  document.getElementById('pb-shuffle').addEventListener('click', (e) => e.currentTarget.classList.toggle('is-on'));
  document.getElementById('pb-repeat').addEventListener('click', (e) => e.currentTarget.classList.toggle('is-on'));

  durEl.textContent = fmt(DURATION);
  render();
</script>
