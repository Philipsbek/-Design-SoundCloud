---
import { art } from '../data/content.js';
export interface Props { title: string; by: string; tracks: string; seed: string; }
const { title, by, tracks, seed } = Astro.props;
const cover = art(seed, 320);
const search = `${title} ${by}`.toLowerCase();
---
<article class="pc" data-search={search} data-play data-title={title} data-artist={by} data-cover={cover}>
  <div class="pc__art">
    <span class="pc__stack pc__stack--2"></span>
    <span class="pc__stack pc__stack--1"></span>
    <img class="pc__img" src={cover} alt={title} loading="lazy" />
    <button class="pc__play" aria-label={`Play ${title}`}>
      <svg class="pc__playIcon" viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
      <svg class="pc__pauseIcon" viewBox="0 0 24 24" width="20" height="20"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
    </button>
    <span class="pc__count">
      <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>{tracks}
    </span>
  </div>
  <h3 class="pc__title">{title}</h3>
  <p class="pc__by">Playlist · {by}</p>
</article>

<style>
  .pc { min-width: 0; }
  .pc.is-filtered { display: none; }
  .pc__art { position: relative; aspect-ratio: 1/1; }
  .pc__stack { position: absolute; left: 50%; transform: translateX(-50%); border-radius: var(--radius) var(--radius) 0 0; }
  .pc__stack--1 { top: -5px; width: 92%; height: 8px; background: #3a3a3a; }
  .pc__stack--2 { top: -10px; width: 84%; height: 8px; background: #2a2a2a; }
  .pc__img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); background: var(--color-graphite); transition: transform .5s cubic-bezier(.16,1,.3,1), filter .25s ease; position: relative; z-index: 1; }
  .pc:hover .pc__img { filter: brightness(.72); }

  .pc__play {
    position: absolute; left: var(--s8); bottom: var(--s8); z-index: 2;
    width: 40px; height: 40px; border-radius: 50%; background: var(--color-orange); color: #fff;
    display: grid; place-items: center; opacity: 0; transform: translateY(6px);
    box-shadow: 0 6px 18px rgba(0,0,0,.45);
    transition: opacity .2s ease, transform .2s ease, background .18s ease;
  }
  .pc:hover .pc__play, .pc.is-playing .pc__play { opacity: 1; transform: none; }
  .pc__play:hover { background: var(--color-orange-hi); }
  .pc__pauseIcon { display: none; }
  .pc.is-playing .pc__playIcon { display: none; }
  .pc.is-playing .pc__pauseIcon { display: block; }

  .pc__count {
    position: absolute; right: var(--s8); bottom: var(--s8); z-index: 2;
    display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: #fff;
    background: rgba(0,0,0,.6); padding: 3px 7px; border-radius: var(--radius);
    opacity: 0; transition: opacity .2s ease;
  }
  .pc:hover .pc__count { opacity: 1; }

  .pc__title { margin-top: var(--s12); font-size: var(--text-body-sm); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pc.is-playing .pc__title { color: var(--color-orange); }
  .pc__by { margin-top: 2px; font-size: var(--text-body-sm); color: var(--color-fog); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
